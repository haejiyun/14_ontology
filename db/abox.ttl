@prefix : <http://www.semanticweb.org/haeji/ontologies/2026/8/untitled-ontology-3/> .
@prefix mall: <https://fastcampus.co.kr/data_online_ontology2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/haeji/ontologies/2026/8/untitled-ontology-3> a owl:Ontology .

:belongsToCategory a owl:ObjectProperty ;
    rdfs:domain :Product ;
    rdfs:range :Category .

:hasCategoryName a owl:DatatypeProperty ;
    rdfs:domain :Category ;
    rdfs:range xsd:string .

:hasComment a owl:DatatypeProperty ;
    rdfs:domain :Review ;
    rdfs:range xsd:string .

:hasDescription a owl:DatatypeProperty ;
    rdfs:domain :Product ;
    rdfs:range xsd:string .

:hasImage a owl:DatatypeProperty ;
    rdfs:domain :Product ;
    rdfs:range xsd:anyURI .

:hasName a owl:DatatypeProperty ;
    rdfs:domain :Product ;
    rdfs:range xsd:string .

:hasPrice a owl:DatatypeProperty ;
    rdfs:domain :Product ;
    rdfs:range xsd:decimal .

:hasRating a owl:DatatypeProperty ;
    rdfs:domain :Review ;
    rdfs:range xsd:integer .

:reviewOf a owl:ObjectProperty ;
    rdfs:domain :Review ;
    rdfs:range :Product .

